# Environment variables template for ShopSphere Monorepo

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL=postgresql://shopsphere_user:shopsphere_password@localhost:5432/shopsphere_db?schema=public

# Security Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_shopsphere_2026
JWT_EXPIRES_IN=7d

# Frontend Configuration (for Vite)
VITE_API_BASE_URL=http://localhost:5000/api
